<svg width="600" height="600" viewBox="0 0 600 600" xmlns="http://w3.org">
  <defs>
    <!-- Definição do padrão de linhas do grid -->
    <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
      <!-- Linha horizontal -->
      <path d="M 0 60 L 60 60" fill="none" stroke="#e0e0e0" stroke-width="2"/>
      <!-- Linha vertical -->
      <path d="M 60 0 L 60 60" fill="none" stroke="#e0e0e0" stroke-width="2"/>
    </pattern>
  </defs>

  <!-- 1. CAMADA DE FUNDO: Quadrados com cores variadas (Exemplos) -->
  <!-- Linha 1 -->
  <rect x="0" y="0" width="60" height="60" fill="#a3e635" /> <!-- Grama -->
  <rect x="60" y="0" width="60" height="60" fill="#a3e635" />
  <rect x="120" y="0" width="60" height="60" fill="#38bdf8" /> <!-- Água -->
  
  <!-- Linha 2 -->
  <rect x="0" y="60" width="60" height="60" fill="#fde047" /> <!-- Areia -->
  <rect x="60" y="60" width="60" height="60" fill="#a3e635" />
  <rect x="120" y="60" width="60" height="60" fill="#38bdf8" />

  <!-- 2. CAMADA DO GRID: Aplicada por cima de tudo -->
  <!-- O preenchimento transparente garante que os quadrados coloridos apareçam por baixo das linhas -->
  <rect width="100%" height="100%" fill="url(#grid)" pointer-events="none" />

  <!-- 3. EXCEÇÃO: Linhas com cores diferentes -->
  <!-- Se precisar de uma linha específica (ex: fronteira ou seleção) com cor diferente, desenhe por cima -->
  <line x1="120" y1="0" x2="120" y2="120" stroke="#ef4444" stroke-width="3" />
</svg>
